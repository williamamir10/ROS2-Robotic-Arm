<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dms_robot_arm">
  <material name="blue"><color rgba="0.12 0.35 0.78 1"/></material>
  <material name="orange"><color rgba="0.95 0.42 0.12 1"/></material>
  <material name="dark"><color rgba="0.18 0.18 0.20 1"/></material>

  <!-- Fixed world anchor keeps the base on the Gazebo working plane. -->
  <link name="world"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.055" length="0.08"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 0.04"/><geometry><cylinder radius="0.055" length="0.08"/></geometry></collision>
    <inertial><origin xyz="0 0 0.04"/><mass value="0.8"/><inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0012"/></inertial>
  </link>

  <joint name="world_to_base" type="fixed"><parent link="world"/><child link="base_link"/><origin xyz="0 0 0"/></joint>

  <!-- L1 is a 12 cm upright link. -->
  <link name="link1">
    <visual><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.025" length="0.12"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0 0 0.06"/><geometry><cylinder radius="0.025" length="0.12"/></geometry></collision>
    <inertial><origin xyz="0 0 0.06"/><mass value="0.35"/><inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00012"/></inertial>
  </link>
  <joint name="joint1" type="revolute"><parent link="base_link"/><child link="link1"/><origin xyz="0 0 0.08"/><axis xyz="0 0 1"/><limit lower="-1.5708" upper="1.5708" effort="5" velocity="1.5"/></joint>

  <!-- L2 is 15 cm long, rotating about the local Y axis. -->
  <link name="link2">
    <visual><origin xyz="0.075 0 0"/><geometry><box size="0.15 0.035 0.035"/></geometry><material name="orange"/></visual>
    <collision><origin xyz="0.075 0 0"/><geometry><box size="0.15 0.035 0.035"/></geometry></collision>
    <inertial><origin xyz="0.075 0 0"/><mass value="0.45"/><inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00090" iyz="0" izz="0.00090"/></inertial>
  </link>
  <joint name="joint2" type="revolute"><parent link="link1"/><child link="link2"/><origin xyz="0 0 0.12"/><axis xyz="0 1 0"/><limit lower="-1.5708" upper="1.5708" effort="5" velocity="1.5"/></joint>

  <!-- L3 is 9 cm long. -->
  <link name="link3">
    <visual><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.03 0.03"/></geometry><material name="blue"/></visual>
    <collision><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.03 0.03"/></geometry></collision>
    <inertial><origin xyz="0.045 0 0"/><mass value="0.25"/><inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00018"/></inertial>
  </link>
  <joint name="joint3" type="revolute"><parent link="link2"/><child link="link3"/><origin xyz="0.15 0 0"/><axis xyz="0 1 0"/><limit lower="-1.5708" upper="1.5708" effort="4" velocity="1.5"/></joint>

  <!-- 6 cm end-effector tool link. -->
  <link name="end_effector">
    <visual><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.025 0.025"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0.03 0 0"/><geometry><box size="0.06 0.025 0.025"/></geometry></collision>
    <inertial><origin xyz="0.03 0 0"/><mass value="0.12"/><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/></inertial>
  </link>
  <joint name="joint4" type="revolute"><parent link="link3"/><child link="end_effector"/><origin xyz="0.09 0 0"/><axis xyz="0 1 0"/><limit lower="-1.5708" upper="1.5708" effort="2" velocity="1.5"/></joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="joint1"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint2"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint3"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint4"><command_interface name="position"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
